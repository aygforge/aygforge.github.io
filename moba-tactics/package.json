{
  "name": "project-moba-tactics",
  "version": "0.1.0",
  "private": true,
  "description": "Project MOBA Tactics - 3v3 MOBA strateji / auto-battler HTML5 prototipi",
  "type": "module",
  "scripts": {
    "generate:assets": "tsx scripts/generate-assets.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:standalone": "vite build --mode standalone && tsx scripts/make-standalone.ts",
    "package:itch": "tsx scripts/package-itch.ts",
    "test": "vitest run",
    "sim": "tsx scripts/sim-report.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "tsx": "4.20.3",
    "typescript": "5.9.3",
    "vite": "6.4.6",
    "vitest": "3.2.7"
  }
}
