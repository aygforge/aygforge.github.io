{
  "name": "kepce-ustasi",
  "version": "0.3.0",
  "private": true,
  "description": "Kepçe Ustası Alpha 0.3 — Ayg Forge portrait HTML5 oyunu",
  "type": "module",
  "scripts": {
    "assets": "node tools/gen-assets.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:sim": "node tests/sim/run-sim.mjs",
    "test:e2e": "node tests/e2e/e2e.mjs",
    "build:artifact": "vite build -c vite.artifact.config.js && node -e \"require('fs').copyFileSync('tools/artifact-index.html','artifact-dist/index.html')\""
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "matter-js": "0.20.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "vite": "6.4.6"
  }
}
