# --- Supabase (online mode: real accounts + real player market) -------------------
# Publishable (anon) key only. NEVER put the service-role/secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Local server mode (node server/dev-server.js) -----------------------------------
# Two browsers can use real separate accounts against your local PostgreSQL.
VITE_LOCAL_SERVER_URL=http://localhost:8787

# Used only by server/dev-server.js (never shipped to the browser):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/varneth
LOCAL_SERVER_SECRET=change-me-to-a-long-random-string
PORT=8787
