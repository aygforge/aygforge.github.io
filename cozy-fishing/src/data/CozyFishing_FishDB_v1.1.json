{
  "game": "Cozy Fishing",
  "schema_version": "design-1.1",
  "status": "gdd_v1_reference_balancing_pending",
  "language": "tr",
  "notes": [
    "Türlerin fiyatları, av güçleri, boy ve ağırlık aralıkları oyun tasarımıdır; gerçek piyasa fiyatları, yasal limitler veya biyolojik maksimumlar değildir.",
    "Bir bölgedeki üç av noktası seçili yerel altı türü içerir; iki komşu bölge geçişi için düşük olasılıklı misafir türler de vardır.",
    "Ağırlıklar türün oltaya vurmaya karar verildiği koşulda normalize edilir; gerçek nihai yakalama oranını tasma ve minigame belirler.",
    "Mevsim, yem ve hava çarpanları sonradan uygulanır, ardından toplam ağırlık yeniden %100 edilir.",
    "Uygunsuz güçteki balıklar ekipman uygunluğu aşamasında filtrelenir ve kalan türler yeniden normalize edilir.",
    "v1.1 düzeltmesi: Derin Deniz Dişlisi, Açık Deniz Teknesi üzerinde otomatik güç 4 avına izin verir; güç 5 yalnızca manuel.",
    "Balık boyu/ağırlığı satış fiyatını değiştirmez. İstif yalnızca tür kimliğine bağlıdır.",
    "Bölge av ağırlıkları temeldir, ana olasılık sıralamasında uygunluk filtresinden sonra yeniden normalize edilir."
  ],
  "constants": {
    "day_energy": 100,
    "stack_size": 10,
    "base_bite_chance": 0.88,
    "season_length_days": 28,
    "year_length_days": 112,
    "bite_reaction_seconds": 1.6,
    "default_fishing_time_seconds": [
      2,
      6
    ],
    "gear_pool_rule": "fish.power <= rod.power + 1",
    "power_penalty_rule": "fish.power == rod.power + 1: tension gain +20%, reel progress speed -20%",
    "season_boost_multiplier": 1.15,
    "weather_favorable_multiplier": 1.1,
    "weather_unfavorable_multiplier": 0.9,
    "bait_favorable_multiplier": 1.6,
    "bait_unfavorable_multiplier": 0.8,
    "basic_bait_multiplier": 1.0,
    "cast_band_species_rule": "Fish whose preferred_cast_band matches cast distance get a 1.25x weight multiplier; mismatched species get a 0.85x multiplier (mid-distance crossovers 1.0x). This is separate from the selected fishing spot.",
    "size_distribution": {
      "normal": {
        "prob": 0.88,
        "t_range": [
          0.08,
          0.73
        ]
      },
      "large": {
        "prob": 0.1,
        "t_range": [
          0.73,
          0.9
        ]
      },
      "exceptional": {
        "prob": 0.02,
        "t_range": [
          0.9,
          1.0
        ]
      }
    },
    "size_length_formula": "round(min_length + t * (max_length-min_length))",
    "size_weight_formula": "round(min_weight + t^3 * (max_weight-min_weight), 2)",
    "size_affects_sale_price": false,
    "species_base_price_constant": true,
    "automatic_daily_total_catch_cap": 6,
    "automatic_max_fish_power": 4,
    "automatic_power_4_requires": "deep_sea_gear_on_offshore_boat",
    "automatic_power_5_allowed": false,
    "automatic_free_basic_bait_allowed": false,
    "cast_energy_charged_at": "valid_cast_release",
    "automatic_progress_trigger": "completed_manual_cast"
  },
